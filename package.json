{
  "name": "lumo-ai",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:electron": "esbuild electron/main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main/index.js && esbuild electron/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.js",
    "build": "npm run build:web && npm run build:electron",
    "start": "node dist/server.cjs",
    "electron:dev": "concurrently -k -n SERVER,ELECTRON \"cross-env NODE_ENV=development tsx server.ts\" \"wait-on tcp:3000 && npm run build:electron && cross-env NODE_ENV=development electron .\"",
    "electron": "npm run build:electron && electron .",
    "sidecar:build": "cd python-sidecar && pyinstaller --onefile --name sidecar sidecar.py",
    "dist": "npm run build && npm run sidecar:build && electron-builder --win",
    "clean": "rm -rf dist dist-electron python-sidecar/dist python-sidecar/build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.hrideshthakur.lumo-ai",
    "productName": "Lumo AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app/dist"
      },
      {
        "from": "python-sidecar/dist/sidecar.exe",
        "to": "python-sidecar/sidecar.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumo AI"
    }
  }
}
